        {
          "name": "Setup Profile",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Accept", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"name\": \"Arjun Das\", \"class\": \"Class 10\", \"school_name\": \"Kolkata High School\", \"district\": \"Kolkata\"}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{base_url}}/profile/setup", "host": ["{{base_url}}"], "path": ["profile", "setup"]}
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Accept", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"name\": \"Arjun Kumar Das\", \"district\": \"Howrah\"}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{base_url}}/profile/update", "host": ["{{base_url}}"], "path": ["profile", "update"]}
          }
        }
      ]
    },
