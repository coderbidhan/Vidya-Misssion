{
  "info": {
    "name": "VidyaMission API",
    "description": "Complete REST API for the VidyaMission student learning platform.\n\nBase URL: {{base_url}}\n\nSet the following environment variables:\n- base_url: http://localhost:8000/api\n- token: (filled automatically after login)\n- student_token, teacher_token, admin_token",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000/api", "type": "string"},
    {"key": "token",    "value": "", "type": "string"}
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\": \"student@example.com\"}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{base_url}}/auth/send-otp", "host": ["{{base_url}}"], "path": ["auth", "send-otp"]}
          }
        },
        {
          "name": "Verify OTP",
          "event": [{"listen": "test", "script": {"exec": ["if (pm.response.code === 200) {", "  var data = pm.response.json().data;", "  pm.environment.set('token', data.token);", "}"], "type": "text/javascript"}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Accept", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\"email\": \"student@example.com\", \"otp\": \"123456\"}", "options": {"raw": {"language": "json"}}},
            "url": {"raw": "{{base_url}}/auth/verify-otp", "host": ["{{base_url}}"], "path": ["auth", "verify-otp"]}
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Accept", "value": "application/json"}],
            "url": {"raw": "{{base_url}}/auth/logout", "host": ["{{base_url}}"], "path": ["auth", "logout"]}
          }
        }
      ]
    },
    {
      "name": "Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}, {"key": "Accept", "value": "application/json"}],
            "url": {"raw": "{{base_url}}/profile", "host": ["{{base_url}}"], "path": ["profile"]}
          }
